rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAllowedFileType() {
      // Validate allowed MIME types: PDF, Office docs, images, videos
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('video/.*');
    }
    
    function isAllowedFileSize() {
      // Limit to 100MB for video, 25MB for documents
      return (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024) ||
             (!request.resource.contentType.matches('video/.*') && request.resource.size < 25 * 1024 * 1024);
    }

    // Public published assets
    match /published/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isAllowedFileType() && isAllowedFileSize();
    }

    // Teacher drafts & uploads
    match /uploads/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && isAllowedFileType() && isAllowedFileSize();
    }
  }
}
