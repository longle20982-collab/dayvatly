rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.admin == true
      );
    }
    
    function isTeacher() {
      return isAuthenticated() && (
        getUserData().role == 'teacher' || 
        getUserData().role == 'admin'
      );
    }
    
    function isOwner(authorId) {
      return isAuthenticated() && request.auth.uid == authorId;
    }

    // Site settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Only admins can alter roles; users can update basic profile
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    // Grade / Subjects / Chapters
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    // Lessons collection
    match /lessons/{lessonId} {
      // Guests can only read published lessons
      allow read: if resource.data.status == 'published' || isTeacher() || isAdmin();
      
      // Teachers can create
      allow create: if isTeacher() && request.resource.data.authorId == request.auth.uid;
      
      // Teachers can update their own drafts/pending, Admins can update/publish anything
      allow update: if isAdmin() || (
        isTeacher() && 
        isOwner(resource.data.authorId) && 
        (resource.data.status != 'published' || isAdmin())
      );
      
      allow delete: if isAdmin() || (isTeacher() && isOwner(resource.data.authorId) && resource.data.status == 'draft');
    }

    // Resources collection (thí nghiệm, video, tài liệu, mô phỏng)
    match /resources/{resourceId} {
      // Public view only gets published items
      allow read: if resource.data.status == 'published' || isTeacher() || isAdmin();
      
      // Teachers can create
      allow create: if isTeacher() && request.resource.data.authorId == request.auth.uid;
      
      // Teachers can update own content; only admin can publish/archive unless author is admin
      allow update: if isAdmin() || (
        isTeacher() && 
        isOwner(resource.data.authorId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['draft', 'pending_review'])
      );
      
      allow delete: if isAdmin() || (isTeacher() && isOwner(resource.data.authorId) && resource.data.status == 'draft');
    }

    // Error reports
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isTeacher() || isAdmin();
    }
  }
}
